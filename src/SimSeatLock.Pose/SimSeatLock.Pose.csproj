<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SimSeatLock.Pose</AssemblyName>
    <RootNamespace>SimSeatLock.Pose</RootNamespace>
    <Version>0.2.0</Version>
    <InformationalVersion>0.2.0</InformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>embedded</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\config\pose.json" Link="config\pose.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\geometry.json" Link="config\geometry.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
